{
  "name": "psps",
  "version": "1.0.1",
  "description": "Password sharing manager backed by Google Sheets with one-shot PIN authentication via email.",
  "private": true,
  "type": "module",
  "author": "Stefano Balocco <stefano.balocco@gmail.com>",
  "license": "BSD-3-Clause",
  "keywords": [
    "credentials",
    "email-auth",
    "google-sheets",
    "hono",
    "nodemailer",
    "one-time-pin",
    "password-sharing",
    "passwords",
    "pin-auth",
    "secret-management",
    "self-hosted"
  ],
  "homepage": "https://github.com/StefanoBalocco/psps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefanoBalocco/psps.git"
  },
  "bugs": {
    "url": "https://github.com/StefanoBalocco/psps/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsBuild all",
    "build:backend": "tsBuild backend",
    "build:frontend": "tsBuild frontend",
    "build:tests": "tsBuild tests",
    "start": "node backend/dist/index.js",
    "tests": "c8 --include=backend/src --include=backend/dist --include=frontend/src --include=frontend/dist --exclude-after-remap --per-file --reporter=text --reporter=lcov ava 'tests/dist/*.test.js' --verbose"
  },
  "dependencies": {
    "@hono/node-server": "^2",
    "@stefanobalocco/zeptologger": "^2",
    "hono": "^4",
    "nodemailer": "^9",
    "undici": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@stefanobalocco/jfsmrouter": "^3",
    "@stefanobalocco/myopie.js": "^2",
    "@stefanobalocco/jtdal": "^6",
    "@stefanobalocco/tsbuild": "^1",
    "@types/node": "^24",
    "@types/jsdom": "^28",
    "@types/nodemailer": "^8",
    "ava": "^8",
    "c8": "^10",
    "jsdom": "^28"
  }
}
